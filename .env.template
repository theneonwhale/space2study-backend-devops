# Environment template for application
# Copy this file to .env and fill in your actual values

NODE_ENV=development
MONGODB_URL=mongodb://your_mongodb_uri
SERVER_PORT=3000
SERVER_URL=http://your_server_url
CLIENT_URL=http://your_client_url
COOKIE_DOMAIN=your_cookie_domain

# JWT Secrets - Replace with your own generated secrets
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=your_jwt_reset_secret
JWT_RESET_EXPIRES_IN=10m
JWT_CONFIRM_SECRET=your_jwt_confirm_secret
JWT_CONFIRM_EXPIRES_IN=24h

# Email Configuration
MAIL_USER=your_email_user
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
MAIL_FIRSTNAME=your_mail_firstname
MAIL_LASTNAME=your_mail_lastname
MAIL_PASS=your_mail_password

# SuperAdmin Configuration
SUPERADMIN_FIRSTNAME=your_superadmin_firstname
SUPERADMIN_LASTNAME=your_superadmin_lastname
SUPERADMIN_EMAIL=your_superadmin_email
SUPERADMIN_PASSWORD=your_superadmin_password


# Additional configuration if needed
# Paths for backend and frontend
BACKEND_PATH=../space2study-backend-devops
FRONTEND_PATH=../space2study-frontend-devops
