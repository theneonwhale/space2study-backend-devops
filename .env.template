# Environment template for production deployment
# Copy this file to .env and fill in your actual values

NODE_ENV=production
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/database
SERVER_PORT=3000
SERVER_URL=http://YOUR_EC2_PUBLIC_IP:3000
CLIENT_URL=http://YOUR_FRONTEND_URL
COOKIE_DOMAIN=YOUR_EC2_PUBLIC_IP

# JWT Secrets
JWT_ACCESS_SECRET=generate_a_super_secret_key_here_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_another_secret_key_here_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=generate_reset_secret_key_here_32_chars_min
JWT_RESET_EXPIRES_IN=10m
JWT_CONFIRM_SECRET=generate_confirm_secret_key_here_32_chars_min
JWT_CONFIRM_EXPIRES_IN=24h

# Email Configuration (Gmail example)
MAIL_USER=email
GMAIL_CLIENT_ID=client_id_here
GMAIL_CLIENT_SECRET=secret_here
GMAIL_REFRESH_TOKEN=token_here
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
MAIL_FIRSTNAME=Space2Study
MAIL_LASTNAME=Team
MAIL_PASS=your_app_specific_password # not_needed_with_oauth

# SuperAdmin Configuration
SUPERADMIN_FIRSTNAME=Super
SUPERADMIN_LASTNAME=Admin
SUPERADMIN_EMAIL=email
SUPERADMIN_PASSWORD=password

# Additional configuration if needed
