# Environment template for Vagrant development
# Copy this file to .env.backend and fill in your actual values

NODE_ENV=development

# --- Network Configuration ---
MONGODB_URL=mongodb://192.168.56.12:27017/space2study
SERVER_PORT=3000
SERVER_URL=http://192.168.56.11:3000
CLIENT_URL=http://localhost:3001
COOKIE_DOMAIN=localhost

# --- JWT Secrets (for development only - DO NOT use these in production) ---
JWT_ACCESS_SECRET=vagrant-super-secret-key-for-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=vagrant-super-secret-key-for-refresh
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=vagrant-super-secret-key-for-reset
JWT_RESET_EXPIRES_IN=10m
JWT_CONFIRM_SECRET=vagrant-super-secret-key-for-confirm
JWT_CONFIRM_EXPIRES_IN=24h

# --- Email Configuration (optional for local development) ---
# You can use a tool like MailHog to catch emails locally
MAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
MAIL_FIRSTNAME=Space2Study
MAIL_LASTNAME=Team
MAIL_PASS=

# --- SuperAdmin Configuration ---
SUPERADMIN_FIRSTNAME=Super
SUPERADMIN_LASTNAME=Admin
SUPERADMIN_EMAIL=admin@local.com
SUPERADMIN_PASSWORD=password
